{
  "version": 2,
  "builds": [
    {
      "src": "wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.12",
        "includeFiles": [
          "app/templates/**",
          "app/static/**",
          "app/models/**",
          "app/routes/**",
          "app/services/**",
          "app/utils/**",
          "app/__init__.py",
          "app/extensions.py",
          "app/sockets.py",
          "migrations/**",
          "config.py"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "wsgi.py"
    }
  ],
  "env": {
    "FLASK_ENV": "production"
  }
}
