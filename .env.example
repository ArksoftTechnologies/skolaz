# ============================================================
# Skolaz v2.0 — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Flask Core ───────────────────────────────────────────────
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-very-long-random-secret-key-in-production

# ── Application ──────────────────────────────────────────────
APP_VERSION=2.0.0
APP_NAME=Skolaz
APP_URL=http://localhost:5000

# ── Database ─────────────────────────────────────────────────
# Development (SQLite — zero config)
DATABASE_URL=sqlite:///skolaz_dev.db

# Production (PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/skolaz_prod

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-another-long-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=2592000

# ── File Storage ─────────────────────────────────────────────
STORAGE_BACKEND=local
# local | s3 | r2
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=26214400
# 25 MB in bytes

# AWS S3 (if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1

# Cloudflare R2 (if STORAGE_BACKEND=r2)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com

# ── Email ────────────────────────────────────────────────────
MAIL_PROVIDER=smtp
# smtp | sendgrid | mailgun
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@skolaz.com

# SendGrid
SENDGRID_API_KEY=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ── SMS / WhatsApp (Twilio) ───────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ── MFA ──────────────────────────────────────────────────────
MFA_ISSUER_NAME=Skolaz

# ── Security ─────────────────────────────────────────────────
WTF_CSRF_SECRET_KEY=change-me-to-yet-another-long-csrf-secret
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400

# ── Rate Limiting ────────────────────────────────────────────
RATELIMIT_DEFAULT=200 per day;50 per hour

# ── Socket.IO ────────────────────────────────────────────────
SOCKETIO_ASYNC_MODE=eventlet
SOCKETIO_LOGGER=0
SOCKETIO_ENGINEIO_LOGGER=0

# ── AI Features (Phase 3) ────────────────────────────────────
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=DEBUG
